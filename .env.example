# WildPulse Bio-Telemetry Command Deck — Environment Configuration
# Copy this file to .env for local full-stack overrides (never commit .env)

# Express telemetry proxy listen port
PORT=3001

# Disk + memory cache TTL in minutes (bounded 15-60)
CACHE_TTL_MINUTES=30

# Optional Movebank credentials for Direct-Read private/restricted studies
# Leave empty to run purely with Public JSON + IOOS ATN ERDDAP + Resilient Fallback
MOVEBANK_USERNAME=
MOVEBANK_PASSWORD=

# Vite public base path (use ./ for portable localhost & GitHub Pages project subpaths)
GITHUB_PAGES_BASE=./
